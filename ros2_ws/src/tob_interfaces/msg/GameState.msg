# [역할]
# 현재 회차의 게임 상태를 한 번에 전달한다.
#
# [포함할 정보]
# 회차 식별자, 레벨, 진행 상태, 시간, 하트, 획득 사탕,
# 탈출 가능 여부와 실패 사유를 포함한다.
#
# [사용 관계]
# 게임 관리 노드가 발행하고 웹 연결부와 제어·안전 노드가 사용한다.
# 웹 연결부는 이 상태를 화면에 전달한다.
#
# [범위]
# 현재 메시지로 게임 상태를 복원할 수 있게 한다.
# 과거 사건 전체를 보관하거나 재생하는 시스템은 만들지 않는다.
# 사탕을 모두 모은 뒤 탈출존에 들어가면 바로 성공한다.
# 탈출문 대기시간이나 문 열림 처리는 추가하지 않는다.
# 게임 관리 노드만 최종 게임 판정을 수행한다.
#
# [완료 기준]
# 현재 메시지로 준비·진행·일시정지·성공·실패를 구분할 수 있다.
# 화면 재접속 시 획득 사탕·하트·시간·탈출 가능 상태를 복원할 수 있다.

# 현재 게임 상태. 게임 관리 노드가 최종 판정하고 발행한다.
uint8 READY=0
uint8 RUNNING=1
uint8 PAUSED=2
uint8 CLEARED=3
uint8 FAILED=4

# 상태를 작성한 시각.
builtin_interfaces/Time stamp
string round_id
uint32 level
uint8 phase

# 일시정지를 제외한 진행시간과 남은 시간. 단위는 초.
float32 elapsed_s
float32 remaining_s

# 현재 하트와 최대 하트. 최대값은 레벨 설정에서 정한다.
uint16 hp
uint16 max_hp

# 전체 사탕 수와 획득한 사탕 식별자 목록.
uint32 candy_total
string[] collected_candy_ids

# 사탕을 모두 모아 탈출할 수 있는 상태인지 표시한다.
bool exit_enabled

# 실패 사유. 사유가 없으면 빈 문자열.
string reason
