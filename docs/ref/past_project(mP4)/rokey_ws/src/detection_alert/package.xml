<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>detection_alert</name>
  <version>0.2.0</version>
  <description>Detection Alert: 고정 웹캠 car 검출 + car의 map 좌표 publish</description>
  <maintainer email="codesorryy@gmail.com">TGS10218</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- webcam_eval.launch.py (로봇 없이 맵 + 웹캠 확인) -->
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- ultralytics(YOLO)는 rosdep 대상이 아니라 venv에 pip로 설치되어 있어야 함 -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
